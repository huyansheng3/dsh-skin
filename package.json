{
  "name": "dsh-skin",
  "version": "0.2.0",
  "description": "Theme / skin plugin for DeepSeek Harness (DSH) web client. Override CSS variables, add background images, and switch themes — loaded as a native Cordis plugin, no browser extension or CDP required.",
  "license": "MIT",
  "author": {
    "name": "huyansheng"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huyansheng3/dsh-skin.git"
  },
  "homepage": "https://github.com/huyansheng3/dsh-skin#readme",
  "bugs": {
    "url": "https://github.com/huyansheng3/dsh-skin/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "dsh-skin": "src/cli/dsh-skin.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./lib/safe-css": "./src/lib/safe-css.mjs",
    "./lib/theme-manager": "./src/lib/theme-manager.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:client",
    "build:client": "node scripts/build-client.mjs",
    "audit:gallery": "node scripts/audit-gallery-themes.mjs",
    "catalog:gallery": "node scripts/build-gallery-catalog.mjs",
    "vendor:gallery": "node scripts/vendor-gallery-themes.mjs",
    "pretest": "npm run build:client",
    "test": "node --test test/*.test.mjs"
  },
  "files": [
    "src",
    "scripts",
    "lib/client.js",
    "themes/cyndi-sugarhigh-2.0",
    "themes/gothic-void",
    "themes/gothic-void-crusade",
    "themes/matrix-green",
    "themes/ocean-breeze",
    "themes/sakura-pink",
    "themes/warm-sunset",
    "gallery/catalog.json",
    "examples",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "immediately": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "skin",
    "theme",
    "cordis",
    "plugin"
  ]
}
